# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included. Needed when the app is served over HTTPS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file when unset.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Stripe -----------------------------------------------------------------
# Default keypair, used for every currency that has no dedicated keypair below.
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Optional per-currency keypairs (two different Stripe accounts):
# STRIPE_USD_PUBLISHABLE_KEY=pk_test_...
# STRIPE_USD_SECRET_KEY=sk_test_...
# STRIPE_EUR_PUBLISHABLE_KEY=pk_test_...
# STRIPE_EUR_SECRET_KEY=sk_test_...

# --- Superuser for automated deploys ----------------------------------------
# `manage.py ensure_superuser` creates/updates this account (used by Docker entrypoint).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Demo data --------------------------------------------------------------
# Set to True to fill the database with demo items/orders on container start.
SEED_DEMO_DATA=True
